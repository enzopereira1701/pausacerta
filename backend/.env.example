# Copie este arquivo para ".env" (na mesma pasta) e ajuste. O ".env" NAO vai para o GitHub.

# Onde estao o Orion (1026) e o STH-Comet (8666).
# Backend no seu PC: IP publico da instancia da AWS (muda a cada sessao do lab).
# Backend em conteiner na instancia: host.docker.internal.
FIWARE_HOST=IP_DA_INSTANCIA

# Os mesmos valores do provisionar.sh
FIWARE_SERVICE=pausacerta
FIWARE_SERVICEPATH=/coleta
EQUIPE_ID=COL-CAM-07

# Quem pode chamar a API pelo navegador (separe por virgula; * = qualquer origem, para abrir no celular)
CORS_ORIGINS=http://localhost:5173

# Segundos sem leitura para o Node contar como offline (o Node envia a cada 60 s)
OFFLINE_SEGUNDOS=150

# Configuração com que o Node LIGA (o Node não a informa; o backend começa nestes valores).
# No Wokwi o firmware usa o regime de demonstração: deixe REGIME_PADRAO=20,3,1.
# Na placa (SIMULACAO_WOKWI 0): 300,90,50. Depois de um setRegime confirmado, vale o confirmado.
REGIME_PADRAO=20,3,1
# LIMITES_PADRAO=27,32,41
# GALAO_PADRAO=5,45,30

# Opcionais
# HISTORICO_MAX=1500      leituras buscadas no STH-Comet por atributo (de 100 em 100)
# ESPERA_COMANDO_S=30     depois disso, um comando sem resposta do Node aparece como "sem resposta"
